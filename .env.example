# Copy to .env and fill in. .env is git-ignored: never commit a real key.

# --- LLM -------------------------------------------------------------------
# Any OpenAI-compatible chat API. Presets: mistral, groq, openrouter, ollama,
# openai_compatible (then set LLM_BASE_URL and LLM_MODEL yourself).
LLM_PROVIDER=mistral

# Keys per provider: keep several and switch with LLM_PROVIDER.
MISTRAL_API_KEY=your-mistral-key     # https://console.mistral.ai -> API Keys
# GROQ_API_KEY=your-groq-key         # https://console.groq.com -> API Keys
# OPENROUTER_API_KEY=your-key        # https://openrouter.ai -> Keys (set LLM_MODEL too)
# Ollama (local) needs no key: install it, `ollama pull qwen2.5:7b`, LLM_PROVIDER=ollama

# Optional overrides
# LLM_MODEL=mistral-small-latest     # default depends on the provider
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MIN_INTERVAL_S=1.5             # pause between requests (free tiers)
# LLM_MAX_RETRIES=8
# LLM_BATCH_ITEMS=40        # blocks per request

# --- Translation -----------------------------------------------------------
# Glossary: data/glossary_<source>_<target>.json is used automatically when it exists.
# GLOSSARY_DIR=data
# GLOSSARY_PATH=data/glossary_en_fr.json   # force one file for every language pair
# TRANSLATION_CACHE=.cache/translations.json

# --- API server --------------------------------------------------------------
# MAX_UPLOAD_MB=20
# MAX_PAGES=50
# JOBS_DIR=.jobs

# --- Document search (RAG) ---
# Embeddings: mistral (API, uses MISTRAL_API_KEY), e5 or qwen3 (local, need: uv sync --extra local), hash (tests)
# EMBEDDER=mistral
# LOCAL_MAX_TOKENS=512  # local models truncate longer passages
# QDRANT_URL=            # empty = embedded Qdrant in data/index/qdrant; http://qdrant:6333 in Docker
# RAG_RAW_DIR=data/raw      # the corpus PDFs (the agent can translate them by report id)
# RAG_CHUNK_CHARS=1000
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=5            # passages given to the LLM to answer a question (/v1/ask)

# --- Agent (LangGraph) ---
# AGENT_CONFIRM_PAGES=50  # longer PDFs: the agent asks before translating

# --- Agent supervisor ---
# Understands the request and reviews the answers: a stronger model than the tools'.
# AGENT_PROVIDER=same       # same = the tools' provider (LLM_PROVIDER); vertex = Gemini on Vertex AI
# AGENT_MODEL=              # same: e.g. mistral-medium-latest (empty = LLM_MODEL)
#                           # vertex: e.g. google/gemini-2.5-pro
# AGENT_MAX_CALLS=40        # supervisor calls per session (cost guard); 0 = no limit
# AGENT_MAX_CALLS_PER_REQUEST=12  # the API's cost guard: supervisor calls per request
# AGENT_RATE_LIMIT_RETRIES=3  # extra retries when the supervisor's model is busy (429)
# AGENT_MAX_STEPS=5         # steps of one request ("traduis … puis …"); more are cut
# AGENT_TRAJECTORIES_DIR=data/trajectories  # one JSON per request (git-ignored)
# AGENT_PRICE_IN_USD=       # optional, per 1M tokens: prints an estimated cost at the end
# AGENT_PRICE_OUT_USD=
# Vertex AI: no key here. Sign in once with
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <your project id>
# VERTEX_PROJECT=           # your Google Cloud project id
# VERTEX_LOCATION=global    # global (cheapest) or a region, e.g. europe-west9 (Paris)
