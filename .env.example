# Copy to .env and fill in. .env is git-ignored: never commit a real key.

# --- LLM -------------------------------------------------------------------
# Any OpenAI-compatible chat API. Presets: mistral, groq, openrouter, ollama,
# openai_compatible (then set LLM_BASE_URL and LLM_MODEL yourself).
LLM_PROVIDER=mistral

# Keys per provider: keep several and switch with LLM_PROVIDER.
MISTRAL_API_KEY=your-mistral-key     # https://console.mistral.ai -> API Keys
# GROQ_API_KEY=your-groq-key         # https://console.groq.com -> API Keys
# OPENROUTER_API_KEY=your-key        # https://openrouter.ai -> Keys (set LLM_MODEL too)
# Ollama (local) needs no key: install it, `ollama pull qwen2.5:7b`, LLM_PROVIDER=ollama

# Optional overrides
# LLM_MODEL=mistral-small-latest     # default depends on the provider
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MIN_INTERVAL_S=1.5             # pause between requests (free tiers)
# LLM_MAX_RETRIES=8
# LLM_BATCH_ITEMS=40        # blocks per request

# --- Translation -----------------------------------------------------------
# Glossary: data/glossary_<source>_<target>.json is used automatically when it exists.
# GLOSSARY_DIR=data
# GLOSSARY_PATH=data/glossary_en_fr.json   # force one file for every language pair
# TRANSLATION_CACHE=.cache/translations.json

# --- API server --------------------------------------------------------------
# MAX_UPLOAD_MB=20
# MAX_PAGES=50
# JOBS_DIR=.jobs
